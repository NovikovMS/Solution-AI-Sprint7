@startuml c4_1_component
!include <C4/C4_Component>

title Сервис приоритизации очереди — компоненты

LAYOUT_TOP_DOWN()
skinparam wrapWidth 180
skinparam maxMessageSize 80

AddRelTag("trust", $textColor="FireBrick", $lineColor="FireBrick", $lineStyle=DashedLine(), $legendText="Граница доверия: ответ модели")
AddRelTag("fail", $textColor="#666666", $lineColor="#666666", $lineStyle=DashedLine(), $legendText="Контракт сломан или фолбэк")

Container_Ext(bus, "Шина событий", "Операции микробатчами")
Container_Ext(featsvc, "Сборщик признаков", "Агрегаты и слова из назначения платежа")
Container_Ext(modelsvc, "Сервис модели", "Оценка подозрительности")
Container_Ext(ctrl, "Сборщик контрольной выборки", "Случайная выборка из всего потока")
Container_Ext(workplace, "Очередь и рабочее место", "Карточка операции")
Container_Ext(journal, "Журнал оценок и решений", "Версия, снимок признаков, решение")

Container_Boundary(svc, "Сервис приоритизации очереди") {
    Component(pack, "Приём микробатча", "Код", "Читает смещение, проверяет идемпотентность: операция + версия + снимок признаков")
    Component(client, "Клиент модели", "Код", "Отдельный компонент: своя версия, таймаут и лимиты")
    Component(calib, "Калибровка и зона воздержания", "Код", "Рабочая шкала, пороги с финмониторингом")
    Component(validator, "Валидатор контракта", "Код", "Схема, диапазон, обязательные поля, запрет полей из будущего")
    Component(route, "Маршрутизатор", "Код", "Писать оценку или оставить порядок правил")
    Component(rank, "Обновление порядка очереди", "Код", "Сортировка. Пометки правил не затирает")
}

Rel(bus, pack, "микробатч операций")
Rel(featsvc, pack, "вектор признаков")
Rel(pack, client, "операции с признаками")
Rel(client, modelsvc, "запрос оценки")
Rel(modelsvc, calib, "оценка и факторы", $tags="trust")
Rel(calib, validator, "оценка на шкале")
Rel(validator, route, "контракт сошёлся")
Rel(validator, route, "контракт сломан", $tags="fail")
Rel(route, rank, "есть оценка")
Rel(route, rank, "нет признаков, нет истории, модель недоступна: порядок правил", $tags="fail")
Rel(rank, workplace, "порядок очереди")
Rel(ctrl, workplace, "карточка без показа оценки")
Rel(validator, journal, "результат проверки")
Rel(route, journal, "причина фолбэка")
Rel(workplace, journal, "решение человека")

Lay_D(pack, client)
Lay_D(client, calib)
Lay_D(calib, validator)
Lay_D(validator, route)
Lay_D(route, rank)

SHOW_LEGEND()
@enduml
